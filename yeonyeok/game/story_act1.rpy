## 1막 — 예고 =========================================================
## 대본 원본: docs/script/act1.md
## 인물: 박정호(48, 살인1 피해자) / 알바생 / 사장 / 경비원 / 이웃A / 윤미경(스침)

# 1막 전용 캐릭터
# 박정호는 죽은 뒤 뉴스에서야 이름이 밝혀진다.
# 그 전까지 유저가 아는 호칭만 사용: "취한 남자" → (사장이 부른) "박 사장"
define park = Character("취한 남자", color="#b08a5a")
define parkn = Character("박 사장", color="#b08a5a")
define clerk = Character("알바생", color="#7f93a8")
define boss = Character("사장", color="#a89070")
define guard = Character("경비원", color="#8a8a8a")
define nb = Character("옆집 남자", color="#9aa8b5")
define cop = Character("경찰", color="#8fa3b8")
define copp = Character("경찰관", color="#8fa3b8")
define shopn = Character("상가 주민", color="#998f80")
define resa = Character("주민", color="#8f8f8f")

# 1막 플래그
default heard_park = False        # 장면1에서 박정호 얘기를 들어줬는가
default clue_park_rule = False    # "아침엔 안 마신다" 단서 획득
default clue_clerk = ""           # 알바생 관련 획득 단서


label act1:

## 장면 1 — 편의점 ---------------------------------------------------
    scene bg room with fade_slow
    "비가 삼일째다."
    "냉장고를 열었다가 닫았다. 어제 사둔 게 아무것도 없었다."
    "밤 열한 시 반. 나는 슬리퍼를 신고 나갔다."
    "우산은 안 가져왔다. 어차피 편의점까지 백 미터고, 백 미터 걷자고 우산 챙기는 게 더 귀찮다."

    scene bg store with fade_slow
    "자동문이 열리면서 찬 공기가 확 끼쳤다. 형광등이 너무 밝았다."

    "냉장고 앞에서 삼각김밥을 집었다가 놓고, 컵라면을 집었다."
    "내일 면접이 있었으면 좋겠는데 없다. 지난주에 넣은 데 세 곳 중 두 곳은 아직 연락이 없고, 한 곳은 어제 불합격 메일이 왔다. 자동 발송인 게 티가 나는 문장이었다."
    "그런 걸 읽으면 화가 나야 정상인 것 같은데, 나는 그냥 '아 이건 템플릿이네' 하고 닫았다."

    "옆에서 술 냄새가 났다."
    park "어이, 아가씨."
    "아가씨. 나는 못 들은 척 진열대를 봤다."
    park "…나 예전엔 사업했어. 진짜야. 직원도 열댓 명 뒀었고."
    park "안 믿기지? 나도 안 믿겨."

    menu:
        "\"아, 네.\" (그냥 나간다)":
            $ heard_park = False
            "\"아, 네.\""
            "이런 사람은 대꾸를 하면 이십 분이 날아간다. 나는 컵라면을 계산대에 올렸다."
            "뒤에서 뭐라고 더 말하는 것 같았는데, 빗소리에 묻혔다."

        "잠깐 들어준다":
            $ heard_park = True
            "컵라면을 계산대에 올려놓고, 나는 그냥 서 있었다. 딱히 이유는 없었다. 집에 가봤자 할 것도 없고."
            park "…어? 안 가?"
            "내가 대꾸를 안 하니까 오히려 그쪽이 당황한 것 같았다."
            park "아니 뭐, 별건 아니고. 그냥— 요즘 사람들이 말을 안 들어줘서."
            "그는 소주병을 만지작거렸다."
            park "나 저기 삼거리에서 인테리어 했었어. 십오 년. 근데 코로나 때 한 번 접고, 다시 세워보려다가 또 접고."
            park "애 엄마는 애 데리고 갔고. 뭐, 갈 만했지."
            park "그래도 나는 아침엔 안 마셔. 그건 안 하기로 했거든. 나름 선이라는 게 있어야지."
            "그가 웃었다. 앞니 하나가 없었다."
            park "…아가씨는 뭐 해? 학생인가?"
            me "취준생이요."
            park "아이고. 그거 힘들지. 힘내."
            "힘내라는 말을 나한테 하는 게 좀 웃겼다. 나는 짧게 목례하고 계산대로 갔다."
            "그는 봉투도 안 받고 소주 두 병을 그냥 들고 나갔다. 비를 맞으면서 걸어가는 뒷모습이 유리문에 잠깐 비쳤다."

    "계산대의 알바생은 눈을 안 마주쳤다."
    clerk "봉투 필요하시죠."
    "물음표가 없는 말투였다. 나는 카드를 내밀었다."
    clerk "...천 이백 원이요."
    "손끝이 스쳤다. 이 애는 늘 여기 있는데, 이름표를 본 기억이 없다."


## 장면 2 — 귀가 -----------------------------------------------------
    "봉투를 들고 나왔다. 비는 아까보다 굵어져 있었다."
    "백 미터를 뛰다시피 걸어서 아파트 현관에 들어섰다. 어깨가 다 젖었다."

    scene bg elevator with fade_slow
    "엘리베이터는 12층에 멈춰 있었다. 버튼을 누르고 기다렸다."
    "기다리는 동안 폰을 봤다. 언니한테 카톡이 와 있었다. 세 시간 전에."

    show screen phone_ui("언니")
    call pmsg("sister", "밥은?")
    call pmsg("sister", "또 컵라면 먹었지")
    call pmsg("sister", "나 지금 지방이라 당분간 못 올라가. 이거 잡으면 진짜 큰 건이야")
    call pmsg("me", "언제 와")
    call pmsg("sister", "몰라 ㅋㅋ 끝나면 바로 갈게")
    call pmsg("sister", "너 문 잘 잠그고 다녀")
    hide screen phone_ui with dissolve

    "언니는 3년째 수습이다. 정직원 전환은 계속 밀리는데, 본인은 특종 하나면 된다고 믿는다."
    "나는 그게 좀 안쓰럽고, 좀 부럽다. 나는 아직 밀릴 자리도 없으니까."

    "엘리베이터가 내려왔다. 문이 열리자 안에서 여자가 하나 내렸다. 간호사복 위에 얇은 가디건. 손에는 편의점 커피."
    "나랑 스치면서 고개를 살짝 숙였다. 나도 숙였다. 그게 전부였다."
    "같은 건물 사람이다. 이 시간에 나가는 걸 몇 번 봤으니까 밤 근무인가 보다."
    "{i}(윗층이었나. 엘리베이터가 늘 위에서 내려오던데.){/i}"

    "7층에서 내렸다. 복도 센서등이 한 박자 늦게 켜졌다."

    scene bg hallway with fade_slow
    "703호 앞에 섰을 때, 704호 문이 열렸다."
    nb "아, 안녕하세요."
    "옆집 사람이다. 재활용 봉투를 들고 나오던 참인 것 같았다."
    nb "비 많이 맞으셨네요. 우산 없으셨구나."
    me "네, 뭐."
    nb "이번 주 내내 온대요. 목요일엔 더 온다던데."
    "그는 봉투를 한 손으로 고쳐 들면서 웃었다. 딱히 할 말이 있어서 하는 말은 아니고, 그냥 마주쳤으니까 하는 말 같았다."
    nb "아, 그리고 요 며칠 밤에 좀 시끄러웠죠? 죄송해요, 제가 짐 정리를 좀 해서."
    me "괜찮아요."
    "사실 시끄러웠는지 기억도 안 났다."
    nb "그럼 들어가세요."

    "나는 도어락을 눌렀다. 삐빅."
    "옆집 사람 이름은 모른다. 이사 온 지 두 달쯤 됐나. 인사는 꼬박꼬박 하는데, 그래서 오히려 더 기억에 안 남는 종류의 사람이었다."


## 장면 3 — 1차 예고장 ----------------------------------------------
    scene bg room with fade_slow
    "현관에 젖은 슬리퍼를 벗어놓고 불을 켰다."
    "원룸이라고 하기엔 조금 크고, 투룸이라고 하기엔 애매한 집이다. 보증금이 딱 거기까지였다."
    "젖은 티셔츠를 벗어서 세탁기에 넣고, 컵라면에 물을 부었다. 삼 분."

    "채용 사이트 탭이 다섯 개 열려 있다. 어제 닫는 걸 깜빡했다."
    "그 옆에 홈캠 앱 창도 떠 있었다. 작년에 언니가 사준 거다."
    sister_voice "혼자 사는데 이런 거 하나는 있어야지."
    "나는 필요 없다고 했는데 언니는 그냥 사서 택배로 보내버렸다. 거절할 수 없게 하는 게 언니 방식이다."
    "거실 쪽을 비추게 놓았고, 켜둔 지 일 년 됐고, 한 번도 뭘 확인한 적은 없다."

    "라면 국물을 버리고 방으로 들어갔다."
    "그리고 책상 위에 있는 봉투를 봤다."

    show note at slide_in_right with dissolve_slow
    "처음엔 우편물인 줄 알았다. 관리비 고지서나 뭐 그런 거."
    "근데 아니었다. 우표도, 주소도, 이름도 없었다. 아무것도 안 적혀 있었다."
    "그리고 {b}책상 위{/b}에 있었다. 우편함이 아니라."

    "나는 현관을 봤다. 잠겨 있었다. 도어락은 방금 내가 눌렀고."
    "베란다 창을 봤다. 닫혀 있었다. 7층이다."
    "아까 나가기 전에 이게 여기 있었나? …모르겠다. 오늘 아침에 이 책상에 앉긴 했는데."

    killer "안녕."
    killer "편지가 좋아. 종이는 손에 남거든. 네가 지금 이걸 잡고 있는 그 느낌, 나는 그게 좋아서 이렇게 해."
    killer "나는 너를 오래 봤어. 너는 나를 안 봤고. 괜찮아. 원래 안 보이는 자리에 있는 게 내 일이야."
    killer "목요일 열한 시. 작업이 하나 있어."
    killer "사람들은 사고라고 할 거야. 스스로 그랬다고 하거나. 매번 그래. 매번 그렇게 말해. 왜 다들 그렇게 쉽게 정리하고 싶어할까."
    killer "아무도 안 봐. 진짜로 아무도 안 봐. 나는 그게 제일 견디기 힘들어."
    killer "근데 너는 볼 수 있을 것 같아. 그래서 부르는 거야."
    killer "아 맞다. 너 언니 있잖아."
    killer "걔 요즘 뭘 자꾸 캐고 다니더라. 사고로 갔다는 사람들. 스스로 갔다는 사람들. 그런 거."
    killer "나 걔 좋아해. 아무도 안 보는 걸 보려고 하잖아. 그런 애는 잘 없어."
    killer "근데 그런 애들은 꼭 너무 가까이 와. 냄새가 날 만큼."
    killer "그러지 말고 네가 와."
    killer "걔는 아직 나를 못 봤어. 너는 볼 수 있고. 그게 다른 거야. 그게 얼마나 큰 차이인지 너는 아직 몰라."
    killer "목요일 지나면 우리 둘만 아는 게 생겨."
    killer "나는 그게 좋아. 지하철이든 어디든, 사람들 사이에 서 있는데 나랑 너만 아는 게 있는 거. 다들 모르는 채로 지나가고."
    killer "생각만 해도 좀. 응."
    killer "너 뭘 할지는 알아. 그래도 눈으로 보고 싶어. 머릿속에 있던 게 밖에서 그대로 일어나는 거, 그게—"
    killer "미안. 이건 봐야 알아."
    killer "잘 봐. 오래 준비했어. 진짜 오래."
    hide note with dissolve

    "나는 이걸 두 번 읽었다."
    "그리고 제일 먼저 든 생각은 — 무섭다가 아니라, {b}어이없다{/b}였다."
    "누가 이런 짓을 하지. 이 짓을 하려면 우리 집에 들어와야 하는데. 들어와서 겨우 종이 한 장 놓고 나갔다고?"

    menu:
        "경찰에 신고한다":
            $ madness += 1
            call act1_police

        "뒷장을 마저 읽는다":
            $ madness += 2
            call act1_backpage

        "사진 찍어서 언니한테 보낸다":
            $ madness += 1
            call act1_tellsister

    jump act1_wednesday


## 선택 B-1 : 경찰 신고 ---------------------------------------------
label act1_police:
    "나는 112를 눌렀다. 이게 정상적인 절차니까."
    show screen call_ui("112")
    cop "네, 어떤 일이신가요."
    me "집에 협박 편지가 들어와 있어요. 목요일에 사람을 죽이겠다고 적혀 있고요."
    cop "편지가… 우편으로 온 건가요?"
    me "아니요. 책상 위에 있었어요."
    cop "그럼 누가 집에 들어왔다는 말씀이신가요? 문은 잠겨 있었고요?"
    me "네."
    "잠깐 침묵이 있었다. 나는 그 침묵이 무슨 뜻인지 알았다."
    cop "혹시 최근에 누구랑 다투신 일이 있으실까요. 지인 중에 장난 같은 걸 칠 만한 분이라거나."
    hide screen call_ui with dissolve

    "이십 분 뒤에 순찰차가 왔다. 경찰관 두 명이 집을 둘러봤다."
    copp "창문도 다 잠겨 있고, 흔적도 없네요."
    copp "일단 편지는 접수해둘게요. 근데 이게… 협박 대상이 특정이 안 돼서요. 누굴 죽이겠다는 건지 이름이 없잖아요."
    "뒷장에는 이름 대신 이런 게 적혀 있었다."
    killer "편의점에서 매일 소주 두 병을 사는 남자."
    copp "이거 갖고는 저희가 뭘 하기가…"
    copp "혹시 무서우시면 며칠 다른 데 가 계시는 것도 방법이에요."
    "그 말을 하는 동안 경찰관은 내 얼굴을 두 번 봤다. 편지가 아니라 나를."
    return


## 선택 B-2 : 뒷장 읽기 ---------------------------------------------
label act1_backpage:
    show note at slide_in_right with dissolve
    killer "편의점에서 매일 소주 두 병 사는 사람. 목요일 밤 열한 시. 그 사람 집."
    killer "방법은 안 쓸게. 그건 글자로 하면 재미가 없어져."
    killer "아 그리고."
    killer "너 이거 두 번 읽었지. 무섭다는 생각보다 어이없다는 생각이 먼저 들었고."
    hide note
    show bg room at shudder
    "나는 종이를 놓았다."
    "그건 맞는 말이었다. 정확히 그 순서였다."
    show note at slide_in_right with dissolve
    killer "지금 현관 봤고, 베란다 봤어. 둘 다 잠겨 있지. 그럴 거야."
    killer "이제 아는 사람 얼굴을 하나씩 떠올릴 차례야. 누가 이런 장난을 치나 하고."
    killer "천천히 해. 나는 그거 보는 거 좋아해."
    killer "사람이 자기 머릿속에서 아는 사람을 하나씩 꺼내서 의심하는 거. 그거 되게—"
    killer "…아니다. 지금 말하면 재미없어."
    hide note with dissolve
    "나는 종이를 접었다. 접다가, 손이 한 번 멈췄다."
    return


## 선택 B-3 : 언니에게 알림 -----------------------------------------
label act1_tellsister:
    show screen phone_ui("언니")
    call pmsg("me", "(사진)")
    call pmsg("me", "이거 우리집 책상에 있었음")
    call pmsg("me", "문 다 잠겨있었는데")
    call pmsg("sister", "뭐야")
    call pmsg("sister", "지금 집이야?")
    call pmsg("me", "ㅇㅇ")
    call pmsg("sister", "문 잠갔어? 지금 당장 확인해")
    call pmsg("me", "잠겨있어")
    call pmsg("sister", "야 그거 사진 더 찍어서 보내봐 뒷장도")
    call pmsg("sister", "나 이거 어디서 본 것 같아")
    call pmsg("sister", "내가 지금 쫓는 건이랑 비슷해")
    call pmsg("sister", "자살로 처리된 사람들인데 이상한 게 좀 있어서 파고 있었거든")
    call pmsg("sister", "근데 그 동네가 너희 동네야")
    hide screen phone_ui with dissolve

    "나는 전화 버튼을 눌렀다."
    show screen call_failed("언니")
    "신호가 세 번 가고 끊겼다."
    hide screen call_failed with dissolve

    show screen phone_ui("언니")
    call pmsg("sister", "미안 지금 통화 못해")
    call pmsg("sister", "여기 잠입이라 소리내면 안돼")
    call pmsg("sister", "문자로 해")
    hide screen phone_ui with dissolve
    return


## 장면 4 — 수요일 조사 ---------------------------------------------
label act1_wednesday:
    scene bg room with fade_slow
    "잠을 세 시간쯤 잤다."
    "밤새 생각한 결론은 이거였다. 편지가 진짜든 장난이든, {b}확인할 수 있는 건 하나뿐{/b}이라는 것."
    "{i}편의점에서 매일 소주 두 병을 사는 남자.{/i}"
    "그 사람이 실제로 있으면 이건 진짜다. 없으면 장난이고."
    "나는 그 남자를 이미 알고 있었다. 어제 봤으니까."

    "옷을 대충 걸치고 나왔다. 엘리베이터를 타고 1층으로 내려가는데, 문득 어제 일이 떠올랐다."
    "누가 우리 집에 들어왔다. 그건 확실하다."

    scene bg guard with dissolve
    "1층 로비 끝에 경비실이 있다. 나가는 길에 유리창을 두드렸다."
    guard "…네."
    me "어제 밤에 우리 집에 누가 들어온 것 같아서요. 7층 703호인데요."
    guard "도둑이요?"
    me "없어진 건 없어요. 근데 뭘 놓고 갔어요."
    guard "…놓고 갔다고요."
    me "네."
    guard "아, 뭐. 택배 잘못 온 거 아니고요?"
    "나는 CCTV 이야기를 꺼냈다."
    guard "그거 보려면 관리사무소에 신청해야 돼요. 서류도 쓰고."
    guard "그리고 어제… 어제가 화요일이지. 화요일 밤은 좀."
    me "왜요?"
    guard "아니 뭐. 저장이 잘 됐나 모르겠어서."
    "그는 내 눈을 안 봤다. 화면 쪽으로 몸을 돌리면서 마우스를 만졌다."
    guard "확인해보고 연락드릴게요."
    "연락은 안 올 거다. 저 말투는 안 올 때 쓰는 말투다."
    guard "…아가씨."
    guard "밤에 문 잘 잠그고 다녀요."

    "경비실을 나와서 그대로 편의점 쪽으로 걸었다. 낮인데도 하늘이 어두웠다."

    scene bg store with fade_slow
    "야간에 있는 애가 아니라 사장이 서 있었다. 나를 보더니 웃었다."
    boss "어! 아가씨 왔네. 오늘은 라면 말고 뭐 좀 드셔."
    "이 사람은 늘 이런 식으로 말한다. 친한 척이 몸에 밴 사람."
    me "저기, 뭐 좀 여쭤볼게요. 여기 매일 밤에 소주 두 병 사가는 아저씨 있잖아요."
    boss "아— 박 사장님?"
    boss "그 양반 여기 단골이지. 원래 삼거리에서 인테리어 하셨는데, 뭐 요즘 사업이 다 어렵잖아."
    boss "근데 그건 왜?"
    me "그냥요. 요 며칠 안 보이시는 것 같아서요."
    boss "어제도 왔는데? 어제 열한 시쯤인가."
    "어제 열한 시. 내가 본 그 시간이다."
    boss "왜, 아가씨도 그 양반한테 뭐 들었어? 자꾸 사람 붙잡고 옛날 얘기 해서 그래."
    boss "나쁜 사람은 아닌데, 술이 문제지 술이."
    "사장이 카운터 아래에서 폰을 확인했다. 화면을 손으로 가리면서."
    boss "아이고, 나 잠깐 나갔다 와야겠네. 재고 좀 보고."
    boss "아가씨 천천히 봐요, 응?"
    "그는 앞치마를 벗으면서 뒷문으로 나갔다. 3시 반에 재고를 보러."

    scene black with fade_slow
    "집에 돌아와서 저녁 내내 시계만 봤다."
    "그 사람은 매일 밤 열한 시쯤 온다고 했다. 그러면 오늘도 올 거다."
    "열 시 사십 분에 다시 나갔다."

    scene bg store with fade_slow
    "나는 잡지 코너 앞에 서서 삼십 분을 기다렸다."
    "그리고 열한 시 십오 분에, 그 사람이 들어왔다."
    "진짜 있었다."
    "편지에 적힌 사람이, 편지에 적힌 대로."

    parkn "총각, 요즘 비가 너무 와."
    clerk "...네."
    parkn "이렇게 오면 공사를 못 해. 다 밀려."
    clerk "…봉투 드릴까요."
    parkn "됐어. 그냥 들고 가."
    "그 사람이 나갔다. 문에 달린 종이 울렸다."

    clerk "…저 아저씨 아세요?"
    me "아뇨."
    clerk "근데 왜 아까부터 보고 계세요."
    "나는 이 애가 언제부터 나를 보고 있었는지 계산해봤다."
    "나는 여기 삼십 분을 서 있었다. 그동안 이 애는 계산대에서 한 번도 고개를 안 들었다. 그렇게 보였다."
    "근데 알고 있었다. 내가 누굴 보고 있었는지까지."
    clerk "...아니에요. 죄송해요."
    "그는 다시 고개를 숙였다."

    menu:
        "\"그쪽은 저 아저씨 잘 알아요?\"":
            $ madness += 1
            $ clue_clerk = "friction"
            clerk "…잘은 몰라요."
            "그는 들고 있던 스캐너를 내려놓았다. 내려놓고는, 다시 집었다가, 또 내려놓았다."
            clerk "매일 오시니까. 그냥."
            me "저 아저씨가 여기서 시비 붙은 적 있어요?"
            "그가 처음으로 나를 똑바로 봤다."
            clerk "…그건 왜 물어보세요?"
            me "그냥요."
            clerk "지난달에 한 번 있었어요. 취해서 술 더 달라고 하시길래 안 된다고 했더니."
            clerk "…욕을 좀 하셨어요. 그게 다예요."
            clerk "CCTV에도 찍혀 있을 거예요. 사장님이 보셨으니까."
            "그는 그 말을 하면서 자기 손을 봤다. 손톱 옆을 뜯고 있었다."
            clerk "저 그때 아무것도 안 했어요."
            "아무도 뭘 했냐고 안 물어봤다."

        "그냥 나온다":
            $ madness += 2
            $ clue_clerk = "umbrella"
            "나는 대답하지 않고 문 쪽으로 갔다."
            clerk "저기요."
            "돌아봤다."
            clerk "…우산."
            "그가 카운터 밑에서 비닐우산을 하나 꺼내 내밀었다."
            clerk "어제도 그냥 맞고 가시길래."
            me "…어제요?"
            clerk "아, 그… 어제 밤에 오셨을 때요. 비 오는데 우산 없으셔서."
            clerk "그냥 놔뒀던 거예요. 폐기 될 거라."
            "나는 우산을 안 받고 나왔다."
            "문에 달린 종이 울렸고, 유리에 비친 그 애는 그대로 서서 나를 보고 있었다."
            "비를 맞으면서 백 미터를 걸어오는 내내, 그 시선이 계속 뒤통수에 있었다."

        "\"저 왜 보고 있었어요?\"":
            $ madness += 2
            $ clue_clerk = "overreact"
            me "저 왜 보고 있었어요?"
            "그가 굳었다."
            clerk "…네?"
            me "지금요. 제가 저 아저씨 보는 거 알고 있었잖아요. 고개도 안 들었으면서."
            clerk "그건, 아니— 손님 오시면 보는 게 당연한 거고."
            me "삼십 분 동안요?"
            "그의 손이 계산대 모서리를 잡았다."
            clerk "…제가 뭐 잘못했어요?"
            clerk "저는 그냥 일하는 거잖아요. 여기서 일하니까 사람이 보이는 거고. 그게 뭐 어떻게."
            "목소리가 조금 커졌다. 뒤에 있던 다른 손님이 우리를 봤다."
            clerk "…죄송합니다."
            "그는 갑자기 고개를 숙였다. 사과할 상황이 아니었는데."
            clerk "손님한테 그러면 안 되는데. 죄송해요."
            "나는 삼천 원짜리 우유를 하나 사서 나왔다. 살 생각도 없었는데."
            "밖에서 유리문 너머로 보니, 그 애는 계산대에 손을 짚고 고개를 숙이고 있었다. 한참 동안."

